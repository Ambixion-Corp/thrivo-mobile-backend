# Environment configuration for the Thrivo Mobile backend.
# Copy this file to .env and adjust values for your environment.

# Port the server listens on (default 5000).
PORT=5000

# Secret used to sign JSON Web Tokens. Change this to a strong, random value
# in production. The default below is only for local development.
JWT_SECRET=super_secret_thrivo_key_2026

# Environment label (development / production).
NODE_ENV=development
